# Скопируйте этот файл в .env и при необходимости поменяйте значения.
# .env в git не попадает (см. .gitignore).

# База данных (используется docker-compose и сервисами)
DB_NAME=shelter
DB_USERNAME=shelter
DB_PASSWORD=shelter
DB_PORT=5432

# Секрет для подписи JWT и заголовков шлюза.
# Должен быть одинаковым во ВСЕХ сервисах и не короче 32 символов (требование HS256).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
