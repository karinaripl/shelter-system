# Скопируйте этот файл в .env и при необходимости поменяйте значения.
# .env в git не попадает (см. .gitignore).
# Без .env всё тоже запустится: в docker-compose.yml есть значения по умолчанию.

# База данных (используется docker-compose и сервисами)
DB_NAME=shelter
DB_USERNAME=shelter
DB_PASSWORD=shelter
DB_PORT=5433

# Секрет для подписи JWT и заголовков шлюза.
# Должен быть одинаковым во ВСЕХ сервисах и не короче 32 символов (требование HS256).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Срок жизни JWT в миллисекундах (28800000 — 8 часов). Уволенный или заблокированный сотрудник
# не может войти заново, но уже выданный токен действует до истечения этого срока.
JWT_EXPIRATION=28800000

# Общий секрет внутреннего API /internal/** между сервисами: auth-service принимает такие запросы
# только с заголовком X-Internal-Token с этим значением, shelter-core-service его передаёт.
# Задайте длинную случайную строку, одинаковую для auth-service и shelter-core-service.
INTERNAL_API_TOKEN=change-me-to-a-long-random-internal-token

# Первый администратор: создаётся при запуске auth-service, если в базе ещё нет ни одного ADMIN.
# Дальше сотрудников и их роли заводит администратор через POST /auth/users.
ADMIN_EMAIL=admin@shelter.local
ADMIN_PASSWORD=change-me-admin-password

# Контексты миграций: default — схема и справочники, demo — демонстрационные данные приюта.
# По умолчанию в docker compose загружаются оба. Чтобы не загружать демо-данные:
# LIQUIBASE_CONTEXTS=default
