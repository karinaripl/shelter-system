{
  "info": {
    "name": "Shelter — шаг 5: склад",
    "description": "Сквозной сценарий шага 5 с автотестами на демо-учётках (пароль demo12345; администратор — admin@shelter.local / admin12345): куратор заводит товар → поставка с двумя партиями (цен и суммы куратор не видит, администратор видит) → остатки выросли → ручной расход с выбором не-FEFO партии → расход больше остатка (409) → расход по FEFO → удаление ошибочного расхода → перемещение на другой склад → списание испорченного → поставка с просроченной партией → её нельзя расходовать (409) → предпросмотр и списание всех просроченных → отчёт «к списанию» пуст → натуральное пожертвование → отчёты: ниже минимума, остатки, истекающие, движение товара. Плюс правила справочников и матрица доступа.\nПовторный запуск возможен: товар создаётся заново на каждый прогон.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8766" },
    { "key": "curatorEmail", "value": "fedorov@demo.shelter.local" },
    { "key": "vetEmail", "value": "lebedev@demo.shelter.local" },
    { "key": "coordinatorEmail", "value": "belova@demo.shelter.local" },
    { "key": "demoPassword", "value": "demo12345" },
    { "key": "adminEmail", "value": "admin@shelter.local" },
    { "key": "adminPassword", "value": "admin12345" }
  ],
  "item": [
    {
      "name": "Подготовка",
      "item": [
        {
          "name": "Вход куратора",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "// Новый суффикс на каждый прогон и даты относительно сегодняшнего дня (UTC, как на сервере)",
              "pm.collectionVariables.set('run', Date.now().toString(36));",
              "const day = (offset) => new Date(Date.now() + offset * 86400000).toISOString().slice(0, 10);",
              "pm.collectionVariables.set('today', day(0));",
              "pm.collectionVariables.set('tomorrow', day(1));",
              "pm.collectionVariables.set('nearExpiration', day(30));",
              "pm.collectionVariables.set('farExpiration', day(200));",
              "pm.collectionVariables.set('oldSupplyDate', day(-60));",
              "pm.collectionVariables.set('yesterday', day(-1));"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('curatorToken', pm.response.json().token);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{curatorEmail}}\",\"password\":\"{{demoPassword}}\"}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Вход ветеринара",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('vetToken', pm.response.json().token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{vetEmail}}\",\"password\":\"{{demoPassword}}\"}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Вход координатора",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('coordinatorToken', pm.response.json().token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{coordinatorEmail}}\",\"password\":\"{{demoPassword}}\"}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Вход администратора",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('adminToken', pm.response.json().token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Куратор: категории товаров",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('categoryId', pm.response.json().find(c => c.name === 'Корм').id);"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "url": "{{baseUrl}}/product-categories"
          }
        },
        {
          "name": "Куратор: склады",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200, не меньше двух складов', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().length).to.be.at.least(2); });",
            "const warehouses = pm.response.json();",
            "const main = warehouses.find(w => w.name === 'Основной склад') || warehouses[0];",
            "const other = warehouses.find(w => w.id !== main.id);",
            "pm.collectionVariables.set('mainWarehouseId', main.id);",
            "pm.collectionVariables.set('otherWarehouseId', other.id);"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "url": "{{baseUrl}}/warehouses"
          }
        },
        {
          "name": "Куратор: поставщики",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200, есть поставщик', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().length).to.be.above(0); });",
            "pm.collectionVariables.set('supplierId', pm.response.json()[0].id);"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "url": "{{baseUrl}}/suppliers"
          }
        }
      ]
    },
    {
      "name": "Сценарий: товар, поставка, расход, списание",
      "item": [
        {
          "name": "Куратор заводит товар с минимальным остатком",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201, в обороте, минимум 50', () => {",
            "  pm.response.to.have.status(201);",
            "  pm.expect(pm.response.json().active).to.eql(true);",
            "  pm.expect(pm.response.json().minStock).to.eql(50);",
            "  pm.expect(pm.response.json().category.name).to.eql('Корм');",
            "});",
            "pm.collectionVariables.set('productId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Корм тестовый {{run}}\",\"categoryId\":{{categoryId}},\"unitOfMeasure\":\"кг\",\"minStock\":50}" },
            "url": "{{baseUrl}}/products"
          }
        },
        {
          "name": "Негатив: товар с тем же названием → 409",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409', () => pm.response.to.have.status(409));",
            "pm.test('Сообщение на русском', () => pm.expect(pm.response.json().message).to.include('уже есть'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"корм тестовый {{run}}\",\"categoryId\":{{categoryId}},\"unitOfMeasure\":\"кг\"}" },
            "url": "{{baseUrl}}/products"
          }
        },
        {
          "name": "Поставка с двумя партиями: куратор не видит цены и сумму",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "const s = pm.response.json();",
            "pm.test('Две партии, поставка не оплачена', () => { pm.expect(s.items.length).to.eql(2); pm.expect(s.paid).to.eql(false); });",
            "pm.test('Суммы поставки нет в ответе', () => pm.expect(s).to.not.have.property('totalAmount'));",
            "pm.test('Цен позиций нет в ответе', () => s.items.forEach(i => pm.expect(i).to.not.have.property('unitPrice')));",
            "pm.test('Принял текущий сотрудник', () => pm.expect(s.employee.fullName).to.eql('Фёдоров Максим Олегович'));",
            "pm.collectionVariables.set('supplyId', s.id);",
            "pm.collectionVariables.set('nearBatchId', s.items[0].batchId);",
            "pm.collectionVariables.set('farBatchId', s.items[1].batchId);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"supplierId\":{{supplierId}},\"warehouseId\":{{mainWarehouseId}},\"notes\":\"Накладная {{run}}\",\"items\":[{\"productId\":{{productId}},\"quantity\":20,\"unitPrice\":300,\"expirationDate\":\"{{nearExpiration}}\"},{\"productId\":{{productId}},\"quantity\":15,\"unitPrice\":320,\"expirationDate\":\"{{farExpiration}}\"}]}" },
            "url": "{{baseUrl}}/supplies"
          }
        },
        {
          "name": "Администратор видит цены и сумму поставки",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('Сумма = 20 × 300 + 15 × 320 = 10800', () => pm.expect(pm.response.json().totalAmount).to.eql(10800));",
            "pm.test('Цены позиций видны', () => pm.expect(pm.response.json().items[0].unitPrice).to.eql(300));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/supplies/{{supplyId}}"
          }
        },
        {
          "name": "Остатки выросли: подсказка FEFO",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const s = pm.response.json();",
            "pm.test('Всего 35 кг, все годные', () => { pm.expect(s.totalQuantity).to.eql(35); pm.expect(s.usableQuantity).to.eql(35); });",
            "pm.test('Рекомендуемая — партия с ближайшим сроком', () => {",
            "  pm.expect(s.batches[0].batchId).to.eql(pm.collectionVariables.get('nearBatchId'));",
            "  pm.expect(s.batches[0].recommended).to.eql(true);",
            "  pm.expect(s.batches[1].recommended).to.eql(false);",
            "});",
            "pm.test('Без цен', () => s.batches.forEach(b => pm.expect(b).to.not.have.property('unitPrice')));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "url": "{{baseUrl}}/products/{{productId}}/stock?warehouseId={{mainWarehouseId}}"
          }
        },
        {
          "name": "Ручной расход: куратор выбирает не-FEFO партию",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "const r = pm.response.json();",
            "pm.test('Партия выбрана вручную и списана именно она', () => {",
            "  pm.expect(r.selection).to.eql('MANUAL');",
            "  pm.expect(r.expenses.length).to.eql(1);",
            "  pm.expect(r.expenses[0].batchId).to.eql(pm.collectionVariables.get('farBatchId'));",
            "  pm.expect(r.expenses[0].quantity).to.eql(5);",
            "});",
            "pm.collectionVariables.set('manualExpenseId', r.expenses[0].id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"productId\":{{productId}},\"warehouseId\":{{mainWarehouseId}},\"batchId\":{{farBatchId}},\"quantity\":5,\"notes\":\"Кормление\"}" },
            "url": "{{baseUrl}}/expenses"
          }
        },
        {
          "name": "Остатки: уменьшилась выбранная партия",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json().batches;",
            "const qty = (id) => b.find(x => x.batchId === pm.collectionVariables.get(id)).quantity;",
            "pm.test('Дальняя партия 15 − 5 = 10, ближняя не тронута (20)', () => { pm.expect(qty('farBatchId')).to.eql(10); pm.expect(qty('nearBatchId')).to.eql(20); });"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "url": "{{baseUrl}}/products/{{productId}}/stock?warehouseId={{mainWarehouseId}}"
          }
        },
        {
          "name": "Негатив: расход больше остатка партии → 409",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409', () => pm.response.to.have.status(409));",
            "pm.test('Нужно / есть', () => pm.expect(pm.response.json().message).to.include('нужно 25 кг, есть 20 кг'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"productId\":{{productId}},\"warehouseId\":{{mainWarehouseId}},\"batchId\":{{nearBatchId}},\"quantity\":25}" },
            "url": "{{baseUrl}}/expenses"
          }
        },
        {
          "name": "Негатив: расход больше остатка на складе (FEFO) → 409",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409', () => pm.response.to.have.status(409));",
            "pm.test('Нужно / есть', () => pm.expect(pm.response.json().message).to.include('нужно 1000 кг, есть 30 кг'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"productId\":{{productId}},\"warehouseId\":{{mainWarehouseId}},\"quantity\":1000}" },
            "url": "{{baseUrl}}/expenses"
          }
        },
        {
          "name": "Расход без выбора партии — по FEFO",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201, FEFO, ближняя партия', () => {",
            "  pm.response.to.have.status(201);",
            "  pm.expect(pm.response.json().selection).to.eql('FEFO');",
            "  pm.expect(pm.response.json().expenses[0].batchId).to.eql(pm.collectionVariables.get('nearBatchId'));",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"productId\":{{productId}},\"warehouseId\":{{mainWarehouseId}},\"quantity\":2}" },
            "url": "{{baseUrl}}/expenses"
          }
        },
        {
          "name": "Удаление ошибочного расхода",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('204', () => pm.response.to.have.status(204));"
          ] } }],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "url": "{{baseUrl}}/expenses/{{manualExpenseId}}"
          }
        },
        {
          "name": "Количество вернулось в ту же партию",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json().batches;",
            "const qty = (id) => b.find(x => x.batchId === pm.collectionVariables.get(id)).quantity;",
            "pm.test('Дальняя партия снова 15, ближняя 18', () => { pm.expect(qty('farBatchId')).to.eql(15); pm.expect(qty('nearBatchId')).to.eql(18); });"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "url": "{{baseUrl}}/products/{{productId}}/stock?warehouseId={{mainWarehouseId}}"
          }
        },
        {
          "name": "Перемещение 3 кг на другой склад",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "pm.test('Со склада на склад', () => {",
            "  pm.expect(pm.response.json().fromWarehouse.id).to.eql(pm.collectionVariables.get('mainWarehouseId'));",
            "  pm.expect(pm.response.json().toWarehouse.id).to.eql(pm.collectionVariables.get('otherWarehouseId'));",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"batchId\":{{nearBatchId}},\"fromWarehouseId\":{{mainWarehouseId}},\"toWarehouseId\":{{otherWarehouseId}},\"quantity\":3,\"notes\":\"Запас в карантин\"}" },
            "url": "{{baseUrl}}/stock-transfers"
          }
        },
        {
          "name": "Списание испорченного",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201, причина DAMAGED', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().reason).to.eql('DAMAGED'); });",
            "pm.test('Списал текущий сотрудник', () => pm.expect(pm.response.json().employee.fullName).to.eql('Фёдоров Максим Олегович'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"batchId\":{{farBatchId}},\"warehouseId\":{{mainWarehouseId}},\"quantity\":2,\"reason\":\"DAMAGED\",\"notes\":\"Порван мешок\"}" },
            "url": "{{baseUrl}}/write-offs"
          }
        },
        {
          "name": "Негатив: причина «истёк срок» для годной партии → 409",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409', () => pm.response.to.have.status(409));",
            "pm.test('Сообщение', () => pm.expect(pm.response.json().message).to.include('не просрочена'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"batchId\":{{farBatchId}},\"warehouseId\":{{mainWarehouseId}},\"quantity\":1,\"reason\":\"EXPIRED\"}" },
            "url": "{{baseUrl}}/write-offs"
          }
        },
        {
          "name": "Негатив: срок годности не позже даты прихода → 400",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400', () => pm.response.to.have.status(400));",
            "pm.test('Сообщение', () => pm.expect(pm.response.json().message).to.include('позже даты прихода'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"supplierId\":{{supplierId}},\"warehouseId\":{{mainWarehouseId}},\"items\":[{\"productId\":{{productId}},\"quantity\":1,\"expirationDate\":\"{{today}}\"}]}" },
            "url": "{{baseUrl}}/supplies"
          }
        },
        {
          "name": "Негатив: поставка датой из будущего → 400",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"supplierId\":{{supplierId}},\"warehouseId\":{{mainWarehouseId}},\"supplyDate\":\"{{tomorrow}}\",\"items\":[{\"productId\":{{productId}},\"quantity\":1}]}" },
            "url": "{{baseUrl}}/supplies"
          }
        }
      ]
    },
    {
      "name": "Просроченные партии",
      "item": [
        {
          "name": "Поставка задним числом с уже просроченной партией",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('expiredBatchId', pm.response.json().items[0].batchId);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
