{
  "info": {
    "name": "Shelter — шаг 6.1: волонтёры и мероприятия",
    "description": "Сквозной сценарий шага 6.1 с автотестами на демо-учётках (пароль demo12345; администратор — admin@shelter.local / admin12345): координатор создаёт волонтёра → закрепляет за животным → повторное закрепление (409) → деактивация с действующим закреплением (409) → закрывает закрепление → куратор видит волонтёра без паспорта → волонтёр неактивен, закрепить его нельзя (409) → менеджер по пристройству создаёт мероприятие на сегодня → добавляет животное → повторно (409) → состояние после → мероприятие на завтра: животное добавляется заранее (201) → вчерашнее мероприятие: менеджер — 409, администратор — 201 → перенос мероприятия убирает выбывшее животное → животное из вчерашнего мероприятия пристраивается → отчёт эффективности → /public/events без токена. Плюс негативные проверки правил и матрицы доступа.\nПовторный запуск возможен: клетка, животные, волонтёр и мероприятия создаются заново на каждый прогон.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8766" },
    { "key": "coordinatorEmail", "value": "belova@demo.shelter.local" },
    { "key": "curatorEmail", "value": "fedorov@demo.shelter.local" },
    { "key": "managerEmail", "value": "orlova@demo.shelter.local" },
    { "key": "vetEmail", "value": "lebedev@demo.shelter.local" },
    { "key": "demoPassword", "value": "demo12345" },
    { "key": "adminEmail", "value": "admin@shelter.local" },
    { "key": "adminPassword", "value": "admin12345" }
  ],
  "item": [
    {
      "name": "Подготовка",
      "item": [
        {
          "name": "Вход координатора",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "// Новый суффикс и паспорт на каждый прогон, даты относительно сегодняшнего дня (UTC, как на сервере)",
              "pm.collectionVariables.set('run', Date.now().toString(36));",
              "pm.collectionVariables.set('cageNumber', ('V' + pm.collectionVariables.get('run')).slice(-10).toUpperCase());",
              "const day = (offset) => new Date(Date.now() + offset * 86400000).toISOString().slice(0, 10);",
              "pm.collectionVariables.set('today', day(0));",
              "pm.collectionVariables.set('tomorrow', day(1));",
              "pm.collectionVariables.set('yesterday', day(-1));",
              "pm.collectionVariables.set('monthAgo', day(-30));",
              "pm.collectionVariables.set('passportSeries', String(1000 + Math.floor(Math.random() * 9000)));",
              "pm.collectionVariables.set('passportNumber', String(100000 + Math.floor(Math.random() * 900000)));"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('coordinatorToken', pm.response.json().token);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{coordinatorEmail}}\",\"password\":\"{{demoPassword}}\"}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Вход куратора",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('curatorToken', pm.response.json().token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{curatorEmail}}\",\"password\":\"{{demoPassword}}\"}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Вход менеджера по пристройству",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('managerToken', pm.response.json().token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{managerEmail}}\",\"password\":\"{{demoPassword}}\"}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Вход ветеринара",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('vetToken', pm.response.json().token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{vetEmail}}\",\"password\":\"{{demoPassword}}\"}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Вход администратора",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('adminToken', pm.response.json().token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Регистрация посетителя",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('visitorToken', pm.response.json().token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"visitor6-{{run}}\",\"email\":\"visitor6-{{run}}@test.local\",\"password\":\"password1\"}" },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Куратор создаёт клетку",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('cageId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"number\":\"{{cageNumber}}\",\"capacity\":5}" },
            "url": "{{baseUrl}}/cages"
          }
        },
        {
          "name": "Куратор: животное 1 (участник и подопечный волонтёра)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('animal1Id', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Участник-{{run}}\",\"gender\":\"M\",\"arrivalDate\":\"{{monthAgo}}\",\"arrivalSourceCode\":\"STREET\",\"cageId\":{{cageId}}}" },
            "url": "{{baseUrl}}/animals"
          }
        },
        {
          "name": "Куратор: животное 2 (выбудет до переноса мероприятия)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('animal2Id', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Выбывший-{{run}}\",\"gender\":\"F\",\"arrivalDate\":\"{{monthAgo}}\",\"arrivalSourceCode\":\"STREET\",\"cageId\":{{cageId}}}" },
            "url": "{{baseUrl}}/animals"
          }
        },
        {
          "name": "Куратор: животное 3 (пристроят после мероприятия)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('animal3Id', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Пристроенный-{{run}}\",\"gender\":\"F\",\"arrivalDate\":\"{{monthAgo}}\",\"arrivalSourceCode\":\"STREET\",\"cageId\":{{cageId}}}" },
            "url": "{{baseUrl}}/animals"
          }
        }
      ]
    },
    {
      "name": "Волонтёры и закрепления",
      "item": [
        {
          "name": "Координатор создаёт волонтёра с паспортом",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "const v = pm.response.json();",
            "pm.test('полная анкета: паспорт, навыки, регистрация сегодня, активен', () => {",
            "  pm.expect(v.passportSeries).to.eql(pm.collectionVariables.get('passportSeries'));",
            "  pm.expect(v.passportNumber).to.eql(pm.collectionVariables.get('passportNumber'));",
            "  pm.expect(v.skills).to.include('Фото');",
            "  pm.expect(v.registrationDate).to.eql(pm.collectionVariables.get('today'));",
            "  pm.expect(v.active).to.eql(true);",
            "});",
            "pm.collectionVariables.set('volunteerId', v.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{coordinatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"fullName\":\"Волонтёр {{run}}\",\"phone\":\"+79990001122\",\"email\":\"volunteer-{{run}}@test.local\",\"skills\":\"Фотосъёмка, социализация\",\"passportSeries\":\"{{passportSeries}}\",\"passportNumber\":\"{{passportNumber}}\"}" },
            "url": "{{baseUrl}}/volunteers"
          }
        },
        {
          "name": "Негатив: тот же паспорт у второго волонтёра → 409",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409', () => pm.response.to.have.status(409));",
            "pm.test('понятное сообщение', () => pm.expect(pm.response.json().message).to.include('уже указан'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{coordinatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"fullName\":\"Двойник {{run}}\",\"passportSeries\":\"{{passportSeries}}\",\"passportNumber\":\"{{passportNumber}}\"}" },
            "url": "{{baseUrl}}/volunteers"
          }
        },
        {
          "name": "Негатив: паспорт без номера → 400",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400', () => pm.response.to.have.status(400));",
            "pm.test('понятное сообщение', () => pm.expect(pm.response.json().message).to.include('серию'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{coordinatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"fullName\":\"Без номера {{run}}\",\"passportSeries\":\"1234\"}" },
            "url": "{{baseUrl}}/volunteers"
          }
        },
        {
          "name": "Координатор закрепляет волонтёра за животным",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "const a = pm.response.json();",
            "pm.test('действует с сегодняшнего дня', () => { pm.expect(a.active).to.eql(true); pm.expect(a.startDate).to.eql(pm.collectionVariables.get('today')); pm.expect(a.endDate).to.eql(null); });",
            "pm.collectionVariables.set('assignmentId', a.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{coordinatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"volunteerId\":{{volunteerId}},\"animalId\":{{animal1Id}},\"notes\":\"Приучение к рукам\"}" },
            "url": "{{baseUrl}}/volunteer-assignments"
          }
        },
        {
          "name": "Негатив: повторное закрепление той же пары → 409",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409', () => pm.response.to.have.status(409));",
            "pm.test('понятное сообщение', () => pm.expect(pm.response.json().message).to.include('уже закреплён'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{coordinatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"volunteerId\":{{volunteerId}},\"animalId\":{{animal1Id}}}" },
            "url": "{{baseUrl}}/volunteer-assignments"
          }
        },
        {
          "name": "Негатив: деактивация волонтёра с действующим закреплением → 409",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409', () => pm.response.to.have.status(409));",
            "pm.test('понятное сообщение', () => pm.expect(pm.response.json().message).to.include('Сначала закройте'));"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{coordinatorToken}}" }],
            "body": { "mode": "raw", "raw": "{\"active\":false}" },
            "url": "{{baseUrl}}/volunteers/{{volunteerId}}/active"
          }
        },
        {
          "name": "Координатор закрывает закрепление",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const a = pm.response.json();",
            "pm.test('закрыто сегодняшним днём', () => { pm.expect(a.active).to.eql(false); pm.expect(a.endDate).to.eql(pm.collectionVariables.get('today')); });"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{coordinatorToken}}" }],
