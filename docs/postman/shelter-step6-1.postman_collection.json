            "const list = pm.response.json();",
            "pm.test('закрытое закрепление в истории', () => { const a = list.find(x => x.id === pm.collectionVariables.get('assignmentId')); pm.expect(a).to.be.an('object'); pm.expect(a.active).to.eql(false); });"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "url": "{{baseUrl}}/animals/{{animal1Id}}/volunteers"
          }
        },
        {
          "name": "Координатор делает волонтёра неактивным",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
