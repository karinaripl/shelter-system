          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('404', () => pm.response.to.have.status(404));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": "{{baseUrl}}/events/{{eventTomorrowId}}"
          }
        },
        {
          "name": "Прошедшее мероприятие с участниками осталось",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('2 участника', () => pm.expect(pm.response.json().participants.length).to.eql(2));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": "{{baseUrl}}/events/{{eventYesterdayId}}"
          }
        },
        {
          "name": "В /public/events мероприятий прогона нет",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const ids = pm.response.json().content.map(e => e.id);",
            "pm.test('удалённых мероприятий нет', () => { pm.expect(ids).to.not.include(pm.collectionVariables.get('eventTodayId')); pm.expect(ids).to.not.include(pm.collectionVariables.get('eventTomorrowId')); });"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/public/events?size=50"
          }
        }
      ]
    }
  ]
}
