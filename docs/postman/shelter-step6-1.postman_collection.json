          }
        },
        {
          "name": "Негатив: закрыть закрепление повторно → 409",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409', () => pm.response.to.have.status(409));"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{coordinatorToken}}" }],
            "url": "{{baseUrl}}/volunteer-assignments/{{assignmentId}}/close"
          }
        },
        {
          "name": "Куратор видит волонтёра без паспорта",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const v = pm.response.json();",
            "pm.test('имя и контакты есть', () => { pm.expect(v.fullName).to.include(pm.collectionVariables.get('run')); pm.expect(v.phone).to.eql('+79990001122'); pm.expect(v.email).to.include('volunteer-'); });",
            "pm.test('паспорта и прочих полей анкеты нет', () => pm.expect(v).to.not.have.any.keys('passportSeries', 'passportNumber', 'skills', 'address', 'birthDate', 'registrationDate', 'active'));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{curatorToken}}" }],
            "url": "{{baseUrl}}/volunteers/{{volunteerId}}"
          }
        },
        {
          "name": "Куратор: волонтёры животного (история)",
